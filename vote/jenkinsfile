pipeline{
    agent any 
    stages{
       stage('checkout'){
          steps{
          }
       }
       stage('install dependencies'){
           steps{
               sh 'npm ci'
           }
       }
       stage('build react app'){
           steps{
               sh 'npm run build'
           }
       }
       stage('build docker images'){
           steps{
               sh 'docker build -t vote-webapp:latest .'
           }
       }
    }
}
